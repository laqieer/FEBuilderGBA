<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FEBuilderGBA.SkiaSharp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to Avalonia 11.3.18's Skia stack (#2067). One process loads
         exactly ONE native libSkiaSharp, so the managed SkiaSharp stack and
         every native SkiaSharp/HarfBuzz asset must stay on the same accepted
         compatibility versions across desktop, Android, iOS, and Browser. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FEBuilderGBA.Core\FEBuilderGBA.Core.csproj" />
  </ItemGroup>
</Project>
